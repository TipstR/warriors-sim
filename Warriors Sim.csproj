<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>WarriorsSim</RootNamespace>
  </PropertyGroup>
  <!-- Non-code files, so they show up in Rider's project view -->
  <ItemGroup>
    <None Include="project.godot" />
    <None Include="docs\**\*" />
    <None Include="scenes\**\*" />
    <None Include="assets\**\*" />
    <None Include="scripts\**\*.uid" />
  </ItemGroup>
</Project>