<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>WarriorsSim</RootNamespace>
  </PropertyGroup>
  <!-- The unit tests and tools (e.g. tools/BalanceRunner) are their own projects, not part of the game -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="tools\**" />
  </ItemGroup>
  <!-- Non-code files, so they show up in Rider's project view -->
  <ItemGroup>
    <None Include="project.godot" />
    <None Include="docs\**\*" />
    <None Include="assets\**\*" />
    <None Include="scripts\**\*.uid" />
    <None Include="ui\**\*.tscn" />
    <None Include="ui\**\*.uid" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="game\pallet_swap.tres" />
    <Content Include="game\Player.tscn" />
    <Content Include="game\scripts\Player.cs.uid" />
  </ItemGroup>
</Project>